{
 "language": "risograph",
 "concept": "一個看不見人影的盛夏追逐：從清晨河堤上的空蟬出發，沿著快斷的線、生鏽的平交道、陽炎與蟬時雨一路往前，最後停在黃昏的小巷。鈷藍與螢光橙兩道孔版油墨疊印在米白紙上，疊出夏天的熱度與恍惚。",
 "styleAnchor": {
  "prompt": "Midsummer daylight in a two-ink mood: saturated cobalt blue and fluorescent orange-pink tones over warm cream highlights, deep ultramarine shadows, a bright luminous band of light along the horizon or around the sun, high contrast, flat bold color areas, clouds layered clearly in foreground, midground and background for depth, hot shimmering nostalgic air. No people, no text, no letters, no logos.",
  "palette": {
   "background": "#14226b",
   "text": "#fff6e3",
   "accent": "#ff5e3a",
   "line": "#3a7bff",
   "glow": "#ffd23f"
  }
 },
 "assets": [
  {
   "id": "a_intro",
   "kind": "image",
   "prompt": "Early morning riverside embankment in midsummer, a translucent cicada shell clinging to a tall grass stem in the close foreground, the river and far bank behind, towering cumulonimbus clouds stacked in three layers, a glowing band of sunrise light on the horizon, wide open sky on the upper half"
  },
  {
   "id": "a_path_run",
   "kind": "image",
   "prompt": "Long narrow path on top of a river embankment running straight into the distance, morning sun low ahead creating a bright horizon glow, layered cumulus clouds near and far, tall summer grass on both sides, wide sky"
  },
  {
   "id": "a_thread",
   "kind": "image",
   "prompt": "A single thin thread stretched between two old wooden utility poles in a quiet residential lane, the thread fluttering and almost snapping in the wind, bright overcast summer sky with layered clouds drifting, sun glowing through a thin cloud patch"
  },
  {
   "id": "a_cloud_glare",
   "kind": "image",
   "prompt": "Low angle view of tiled rooftops and a TV antenna under a thick overcast summer sky, the hidden sun blazing through the cloud layer as a dazzling white-gold glare, foreground dark clouds and brighter background clouds, strong contrast"
  },
  {
   "id": "a_mirage",
   "kind": "image",
   "prompt": "Wide river seen from a riverside path at noon, heat haze rising so the far bank and a small iron bridge float like a mirage over shimmering water, layered clouds above, bright light band on the horizon, reeds in the foreground"
  },
  {
   "id": "a_rail",
   "kind": "image",
   "prompt": "Single-track railway line crossing two intersecting country roads in summer afternoon, railroad crossing signals and barrier poles, rails gleaming toward the vanishing point, big layered clouds overhead, strong shadows"
  },
  {
   "id": "a_tailwind",
   "kind": "image",
   "prompt": "Hillside field of tall summer grass bending all in one direction under a strong tailwind, streaks of clouds racing across the sky in foreground and background layers, a bright opening of sunlight in the clouds ahead"
  },
  {
   "id": "a_chorus",
   "kind": "image",
   "prompt": "Dazzling midsummer sky above a small hilltop town, sunbeams pouring through gaps between huge layered cumulus clouds, green leaves fluttering down through the air in the foreground, intense bright light band on the horizon, deep blue sky at the top"
  },
  {
   "id": "a_shrine_steps",
