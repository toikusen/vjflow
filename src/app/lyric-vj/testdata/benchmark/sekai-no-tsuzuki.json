{
 "language": "silkscreen",
 "concept": "一座小島海岸的一天一夜：從童年夏日的海邊、褪去的秋日沙灘，到星光下遼闊的夜海；風帶著翅膀迎向黎明。最後在小路盡頭的晨光裡，相約在夢的延續中重逢。",
 "styleAnchor": {
  "prompt": "Saturated limited palette of deep indigo night, ocean blue, coral and warm gold; sky built from a few distinct horizontal color bands, deep dark shadows, one bright luminous band of light along the horizon or light source, layered foreground and background clouds for depth, nostalgic and hopeful seaside mood, high contrast, never grey or washed out. No text, no letters, no logos.",
  "palette": {
   "background": "#141a3c",
   "text": "#fff4e0",
   "accent": "#ff6a3d",
   "line": "#f2c14e",
   "glow": "#ffb36b"
  }
 },
 "assets": [
  {
   "id": "a_intro",
   "kind": "image",
   "prompt": "Pre-dawn small island harbor, a white lighthouse on a rocky point at right, calm deep indigo sea, a thin bright coral band of first light on the horizon, layered stratus clouds in front and high clouds behind, a few fading stars, wide open sky in the upper half."
  },
  {
   "id": "a_beach",
   "kind": "image",
   "prompt": "Summer afternoon on a small cove beach, rocky tide pools and scattered seashells in the foreground, an old wooden pier reaching into turquoise water, tall cumulus clouds stacked in near and far layers, a brilliant sun glare band on the sea, lots of open sky."
  },
  {
   "id": "a_autumn",
   "kind": "image",
   "prompt": "The same cove beach in late autumn at dusk, empty sand, a closed wooden beach hut with shutters down, dune grass bending in the wind in the foreground, orange-red horizon band, long streaks of clouds in two layers drifting across, deep blue upper sky."
  },
  {
   "id": "a_starsea",
   "kind": "image",
   "prompt": "Night beach under a dense starry sky with the Milky Way arching overhead, calm sea reflecting starlight as a glittering path, low dark headland silhouettes on both sides, thin luminous blue band on the horizon, a few low clouds in the foreground and thin high clouds behind."
  },
  {
   "id": "a_cliffnight",
   "kind": "image",
   "prompt": "View from a grassy sea cliff at night over a vast endless ocean, rising moon just above the horizon casting a wide bright band of light across the water, layered night clouds near and far, deep indigo sky full of stars, grass tufts in the near foreground."
  },
  {
   "id": "a_dawnwind",
   "kind": "image",
   "prompt": "Dawn over the sea seen from a cliff edge, strong wind stretching clouds into long diagonal streaks in foreground and background layers, a few tiny seabirds far away in the sky, grass bending sideways, bright gold band of sunrise on the horizon, deep blue upper sky."
  },
  {
   "id": "a_ship",
   "kind": "image",
   "prompt": "Open sea at bright midday, a tiny distant sailing ship on the horizon, towering cumulus clouds in several depth layers, vivid cobalt water with sparkling sunlight band, wide sky."
  },
  {
   "id": "a_cloudsea",
   "kind": "image",
   "prompt": "After a storm over the ocean, dark clouds breaking apart in layers, golden sunbeams pouring through the gaps onto the sea, bright light patch on the water, deep shadowed cloud undersides in front, lighter clouds far behind."
  },
  {
   "id": "a_tide",
   "kind": "image",
   "prompt": "Evening shoreline, gentle waves washing over a line of footprints in wet sand in the foreground, magenta and orange sunset band on the horizon, sun half sunk into the sea, layered pink clouds near and far, deep violet upper sky."
  },
  {
   "id": "a_waves",
   "kind": "image",
   "prompt": "Large rolling waves breaking toward the shore at twilight, white spray in the foreground, deep blue water, a narrow bright coral band where the sky meets the sea, layered dark clouds above."
  },
  {
   "id": "a_road",
   "kind": "image",
   "prompt": "A long narrow coastal road running along the cliffs toward a cape at dawn, at the very end of the road a tiny distant still silhouette with one hand raised, sunrise gold band behind the cape, layered morning clouds, sea on one side."
  },
  {
   "id": "a_stage",
   "kind": "image",
   "prompt": "An empty small open-air stage by the sea at dusk, wooden boards and rows of empty benches, warm string lights hanging over it, the sea and a bright orange horizon band behind, layered dusk clouds."
  },
  {
   "id": "a_dream",
   "kind": "image",
   "prompt": "Deep night sea with a lighthouse on a distant point sweeping a long beam of light across the water, dense stars, soft layered clouds catching the beam, calm reflective water, indigo and violet sky."
  },
  {
   "id": "a_dawn",
   "kind": "image",
   "prompt": "Sunrise breaking over the open sea, the sun just clearing the horizon, an intense gold and coral band of light spreading across the water, layered clouds lit from below in front and pale high clouds behind, deep blue sky fading upward."
  },
  {
   "id": "a_morning",
   "kind": "image",
   "prompt": "Bright clear morning over the island harbor, the lighthouse on the rocky point, calm blue sea with sparkling light band, small boats moored, fresh cumulus clouds in near and far layers, wide open sky."
  }
