// Writes the renderer's measure as a table the plan can read without a browser (render/layout-measure.ts, Q1 phase 3c,
// docs/research/2026-11-10-q1-phase3c.md): every family of fonts.ts, at the weight the world layout measures with, each
// character of the Latin, punctuation, kana and full-width blocks and of every song's lyrics on disk, read in the
// renderer's own browser (real-advances.mts). Only advances the table's rule (layout-measure ruleAdvance) does not
// already give are kept. Then reads it back and reports the largest gap between the table and the browser.
//   npx tsx --tsconfig tsconfig.json scripts/lyric-vj/advance-table.mts [--check]
import { execSync } from 'node:child_process';
import { readFileSync, writeFileSync } from 'node:fs';
import { parseArgs } from 'node:util';
import { FONTS } from '../../src/app/lyric-vj/fonts';
import { layoutMeasure, ruleAdvance } from '../../src/app/lyric-vj/render/layout-measure';
import { realAdvances } from './real-advances.mts';

const { values: a } = parseArgs({ options: { check: { type: 'boolean', default: false } } });
const range = (from: number, to: number) => Array.from({ length: to - from + 1 }, (_, i) => String.fromCodePoint(from + i));
const BLOCKS = [range(0x20, 0x7e), range(0xa0, 0xff), range(0x2010, 0x2027), range(0x2030, 0x205e), range(0x3000, 0x303f), range(0x3040, 0x30ff), range(0xff01, 0xffef)].flat();
// (every lyric on disk: the songs the plans are made from)
const files = execSync("find -L out/db out/beta/songs out/indigo out/research/song-flow -maxdepth 4 -name song.json 2>/dev/null || true", { encoding: 'utf8' }).split('\n').filter(Boolean);
const lyric = new Set<string>();
for (const f of files) { try { for (const c of JSON.parse(readFileSync(f, 'utf8')).cues ?? []) for (const ch of c.text ?? '') lyric.add(ch); } catch { /* not a song */ } }
const chars = [...new Set([...BLOCKS, ...lyric])].filter((c) => c !== '\n' && c !== '\t');
const real = await realAdvances();
// (two decimals at size 100: under 0.01 px a character at 200 px type)
const r3 = (x: number) => Math.round(x * 100) / 100;
const table: Record<string, [string, string]> = {};
let worst = { gap: 0, family: '', char: '' };
for (const f of FONTS) {
  const adv = await real.advances(f.family, chars);
  if (a.check) {
    const m = layoutMeasure(f.family);
    chars.forEach((c, i) => { const gap = Math.abs(m(c) - adv[i]); if (gap > worst.gap) worst = { gap, family: f.family, char: c }; });
    continue;
  }
  const kept = chars.flatMap((c, i) => (Math.abs(r3(adv[i]) - ruleAdvance(c)) > 0.005 ? [[c, r3(adv[i])] as const] : []));
  table[f.family] = [kept.map(([c]) => c).join(''), kept.map(([, v]) => v).join(',')];
  console.error(`${f.family}: ${kept.length} of ${chars.length} off the rule`);
}
await real.close();
if (a.check) {
  console.log(JSON.stringify({ families: FONTS.length, chars: chars.length, songs: files.length, worstPer100: worst }));
} else {
  const body = Object.entries(table).map(([k, [c, v]]) => `  ${JSON.stringify(k)}: [${JSON.stringify(c)}, ${JSON.stringify(v)}],`).join('\n');
  writeFileSync('src/app/lyric-vj/render/advance-table.ts', `// Generated by scripts/lyric-vj/advance-table.mts: each family's advances at size 100 (world-layout's weight) where they
// differ from layout-measure ruleAdvance, read in the renderer's browser from the self-hosted faces (${chars.length} characters:
// Latin, punctuation, kana, full-width and every lyric on disk, ${files.length} song files). Do not edit by hand.
export const ADVANCE_TABLE: Record<string, [string, string]> = {
${body}
};
`);
  console.log(`wrote ${Object.keys(table).length} families, ${chars.length} characters each`);
}
