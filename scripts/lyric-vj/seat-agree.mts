// Plan against picture, on the real faces (Q1 phase 3c, docs/research/2026-11-10-q1-phase3c.md): for the five
// single-page worlds' fonts and Huninn, each test line's characters read in the renderer's own browser (real-advances.mts,
// the world layout's measure), then every seat of the five worlds, one slot and two, laid by the plan (seat-geometry
// laidSeat on layout-measure's table) and by the renderer's measure (laidSeat on the browser's advances, as world-layout
// calls it), and art-deco's marquee split (panelSplit) both ways. Writes the advances as the unit test's fixture
// (render/seat-agree.fixture.ts) and the largest gaps.
//   npx tsx --tsconfig tsconfig.json scripts/lyric-vj/seat-agree.mts [--out out/research/q1-1109/seat-agree-3c.json]
import { execSync } from 'node:child_process';
import { writeFileSync } from 'node:fs';
import { parseArgs } from 'node:util';
import { FREE_STYLES } from '../../src/app/lyric-vj/free-styles';
import { WORLD_COMPOSITIONS, pageSeatsOf } from '../../src/app/lyric-vj/world-shared';
import { evenMeasure, laidSeat, panelSplit } from '../../src/app/lyric-vj/render/seat-geometry';
import { SET_SPECS } from '../../src/app/lyric-vj/render/world-sets';
import { SEAT_TEXTS } from '../../src/app/lyric-vj/render/seat-agree.texts';
import { realAdvances } from './real-advances.mts';

const { values: a } = parseArgs({ options: { out: { type: 'string', default: 'out/research/q1-1109/seat-agree-3c.json' } } });
const worlds = Object.keys(WORLD_COMPOSITIONS);
const fonts = [...new Set([...worlds.flatMap((id) => { const f = FREE_STYLES.find((s) => s.id === id)!.fonts; return [f.ja, f.tc]; }), 'Huninn'])];
const chars = [...new Set(SEAT_TEXTS.flatMap((t) => [...t]))];
const real = await realAdvances();
const fixture: Record<string, Record<string, number>> = {};
for (const f of fonts) { const adv = await real.advances(f, chars); fixture[f] = Object.fromEntries(chars.map((c, i) => [c, adv[i]])); }
await real.close();
writeFileSync('src/app/lyric-vj/render/seat-agree.fixture.ts', `// Generated by scripts/lyric-vj/seat-agree.mts: each test line's characters (seat-agree.texts.ts) read in the renderer's
// browser from the self-hosted faces at the world layout's weight, size 100. Do not edit by hand.
export const REAL_ADVANCES: Record<string, Record<string, number>> = ${JSON.stringify(fixture)};
`);
const worst = { box: { px: 0, at: '' }, size: { px: 0, at: '' }, panel: { px: 0, at: '' }, splitDisagree: [] as string[] };
let compared = 0;
for (const id of worlds) {
  const world = FREE_STYLES.find((s) => s.id === id)!.world;
  const sets = [...new Set([...world.layouts.lines.map((l) => l.set), ...pageSeatsOf(id)])];
  for (const font of fonts)
    for (const set of sets)
      for (const slot of [{ k: 0, of: 1 }, { k: 0, of: 2 }])
        for (const text of SEAT_TEXTS) {
          // (the renderer's measure as world-layout measureOf takes it: an even set one em a character)
          const realM = SET_SPECS[set]?.even ? evenMeasure : (x: string) => [...x].reduce((w, c) => w + fixture[font][c], 0);
          const p = laidSeat(text, set, { slot, font })!;
          const r = laidSeat(text, set, { slot, measure: realM })!;
          const at = `${font} ${set} ${slot.of} ${text}`;
          compared++;
          const d = Math.max(...(['x0', 'x1'] as const).map((k) => Math.abs(p.boxPx[k] - r.boxPx[k])), ...(['y0', 'y1'] as const).map((k) => Math.abs(p.boxPx[k] - r.boxPx[k])));
          if (d > worst.box.px) worst.box = { px: d, at };
          if (Math.abs(p.size - r.size) > worst.size.px) worst.size = { px: Math.abs(p.size - r.size), at };
          if (slot.of === 1 && set.startsWith('art-deco/marquee')) {
            const [pp, rp] = [panelSplit(p), panelSplit(r)];
            if (!!pp !== !!rp) worst.splitDisagree.push(at);
            if (pp && rp) for (const k of ['main', 'panel'] as const) for (const e of ['x0', 'y0', 'x1', 'y1'] as const) { const g = Math.abs(pp[k][e] - rp[k][e]); if (g > worst.panel.px) worst.panel = { px: g, at: `${at} ${k}.${e}` }; }
          }
        }
}
const out = { commit: execSync('git rev-parse --short HEAD').toString().trim(), fonts, texts: SEAT_TEXTS, compared, worst, note: 'plan = laidSeat on layout-measure (the table); render = laidSeat on the browser advances, as world-layout calls it; px at 1080p' };
writeFileSync(a.out!, JSON.stringify(out, null, 1));
console.log(JSON.stringify(out));
